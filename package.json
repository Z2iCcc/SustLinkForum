{
  "name": "sustlink-forum-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "test": "node --experimental-strip-types --test tests/store.test.ts tests/publishing.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.md index.html"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
